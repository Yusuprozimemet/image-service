<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  Project rule set for the image service.

  Deliberately not google_checks.xml. That rule set mandates 2-space indentation,
  and this codebase (like Spring itself and most Java) uses 4 — which alone
  produced 698 of 828 findings, none of which say anything about correctness.
  A gate that noisy gets ignored, which defeats the point.

  What is kept is the part that earns its place: unused imports, naming, missing
  braces, empty blocks, and the small set of checks that catch genuine bug
  classes (== on strings, broken equals/hashCode, missing @Override).

  Everything here is severity=warning, and the Maven plugin is configured with
  violationSeverity=warning, so any finding fails the build.
-->
<module name="Checker">
    <property name="severity" value="warning"/>
    <property name="fileExtensions" value="java"/>

    <!-- Mixing tabs and spaces renders differently for everyone who opens it. -->
    <module name="FileTabCharacter"/>

    <module name="LineLength">
        <property name="max" value="120"/>
        <property name="ignorePattern" value="^package.*|^import.*|https?://"/>
    </module>

    <module name="TreeWalker">

        <!-- Imports -->
        <module name="UnusedImports"/>
        <module name="RedundantImport"/>
        <module name="IllegalImport"/>

        <!-- Naming -->
        <module name="PackageName"/>
        <module name="TypeName"/>
        <module name="MethodName"/>
        <module name="MemberName"/>
        <module name="ParameterName"/>
        <module name="LocalVariableName"/>
        <module name="ConstantName">
            <!-- Allow the near-universal SLF4J idiom `private static final Logger log`
                 alongside normal SCREAMING_SNAKE constants. -->
            <property name="format" value="^log$|^[A-Z][A-Z0-9]*(_[A-Z0-9]+)*$"/>
        </module>

        <!-- Structure: braces are not optional. A missing brace around a single
             statement is how the Apple "goto fail" TLS bug happened. -->
        <module name="NeedBraces"/>
        <module name="LeftCurly"/>
        <module name="RightCurly"/>
        <module name="EmptyBlock">
            <property name="option" value="text"/>
        </module>
        <module name="EmptyStatement"/>
        <module name="UpperEll"/>
        <module name="ArrayTypeStyle"/>

        <!-- Real bug classes -->
        <module name="EqualsHashCode"/>
        <module name="StringLiteralEquality"/>
        <module name="MissingOverride"/>
        <module name="SimplifyBooleanExpression"/>
        <module name="SimplifyBooleanReturn"/>
        <module name="FallThrough"/>
        <module name="DefaultComesLast"/>
        <module name="MultipleVariableDeclarations"/>
        <module name="OneStatementPerLine"/>

        <!-- Whitespace sanity, without dictating indent width -->
        <module name="WhitespaceAfter"/>
        <module name="NoWhitespaceBefore"/>
        <module name="GenericWhitespace"/>
        <module name="MethodParamPad"/>
        <module name="ParenPad"/>
    </module>
</module>
