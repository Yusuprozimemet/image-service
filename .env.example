# Copy to .env and fill in real values. .env is git-ignored — never commit it.
#
# Spring Boot does not read .env on its own. Either:
#   - load these into your IDE run configuration, or
#   - let `docker compose` read them (it picks up .env automatically), or
#   - export them in the shell before `./mvnw spring-boot:run`.

# --- Database (local defaults match compose.yaml; override for a remote DB) ---
# Bound by application.yaml via relaxed binding (SPRING_DATASOURCE_URL ->
# spring.datasource.url). In local dev, spring-boot-docker-compose wires Postgres
# in automatically, so these are only needed when running against another DB.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/imagedb
SPRING_DATASOURCE_USERNAME=dev
SPRING_DATASOURCE_PASSWORD=dev

# --- Active profile (dev locally, prod in the cloud) ---
SPRING_PROFILES_ACTIVE=dev

# --- Server port (optional; Render injects PORT, falls back to 8080) ---
# PORT=8080

# --- Grafana Loki log shipping (used only by the prod profile) ---
# From your Grafana Cloud stack: the Loki base URL, the numeric instance/user ID,
# and a write-scoped access-policy token. Under any non-prod profile these are
# ignored and no connection to Grafana is opened.
LOKI_URL=https://logs-prod-XXX.grafana.net
LOKI_USERNAME=your-grafana-instance-id
LOKI_API_TOKEN=glc_your_write_token

# --- Backblaze B2 (image storage) ---
# Endpoint and region come from your bucket's details in the B2 console; the key
# id / application key from an application key you create. Endpoint and region have
# working defaults in application.yaml; bucket and keys must be set to upload.
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
B2_BUCKET=your-bucket-name
B2_ACCESS_KEY=your-key-id
B2_SECRET_KEY=your-application-key

# --- Session (reserved — not wired into the app yet) ---
# APP_SESSION_TTL_DAYS=7

# --- LLM / Gemini (AI image tagging) ---
# API key from Google AI Studio (bound to app.gemini.api-key). Model and base URL
# have defaults in application.yaml; the key must be set for tagging to run.
LLM_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
